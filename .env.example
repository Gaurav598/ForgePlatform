# ═══════════════════════════════════════════════════════════
# FORGE AI — Environment Variables (Development)
# Copy to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════

# ── Next.js ────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=FORGE AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ── Spring Boot API ────────────────────────────────────────
SERVER_PORT=8080
MONGO_URI=mongodb+srv:
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=forgeai
RABBITMQ_PASS=forgeai_dev_pass
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-immediately
CORS_ORIGINS=http://localhost:3000

# ── OAuth (fill in your credentials) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── AI Providers (fill in your API keys) ──────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=

# ── Payments (optional for dev) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
